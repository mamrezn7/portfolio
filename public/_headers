# Cloudflare Pages response headers.
#
# Next's static export writes the generated images without a file extension,
# so without these they would be served as application/octet-stream and
# social previews would not show them.
/opengraph-image
  Content-Type: image/png
/work/*/opengraph-image
  Content-Type: image/png
/cv/opengraph-image
  Content-Type: image/png
/writing/*/opengraph-image
  Content-Type: image/png
/writing/opengraph-image
  Content-Type: image/png
/apple-icon
  Content-Type: image/png

# Hashed build output never changes under the same name.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/3d/*
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
